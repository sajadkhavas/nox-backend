APP_NAME="LBB"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_TIMEZONE=Asia/Tehran

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lbb
DB_USERNAME=lbb
DB_PASSWORD=

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_ENCRYPT=true

FRONTEND_URL=http://localhost:3000
FRONTEND_URLS=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# Server-only credential used by the frontend SSR runtime to select a dedicated,
# still-bounded catalog rate-limit bucket. Never expose this through a VITE_* variable.
LBB_SSR_RATE_LIMIT_TOKEN=
LBB_SSR_CATALOG_RATE_LIMIT_PER_MINUTE=600

FILESYSTEM_DISK=public

# P4 commerce stays fail-closed until the explicit production activation gate.
CHECKOUT_ENABLED=false
INVENTORY_RESERVATION_MINUTES=30

DELIVERY_IMMEDIATE_COURIER_ENABLED=false
DELIVERY_IMMEDIATE_COURIER_FEE_TOMAN=0
DELIVERY_TIPAX_ENABLED=false
DELIVERY_TIPAX_FEE_TOMAN=0
DELIVERY_DECAPOST_ENABLED=false
DELIVERY_DECAPOST_FEE_TOMAN=0
DELIVERY_EXPRESS_POST_ENABLED=false
DELIVERY_EXPRESS_POST_FEE_TOMAN=0

# Deprecated compatibility switches. Keep disabled for P4 production.
DELIVERY_STANDARD_ENABLED=false
DELIVERY_STANDARD_FEE_TOMAN=0
DELIVERY_PICKUP_ENABLED=false
DELIVERY_PICKUP_FEE_TOMAN=0

PAYMENT_ENABLED=false
PAYMENT_PROVIDER=disabled
ZARINPAL_MERCHANT_ID=
PAYMENT_CALLBACK_URL=http://localhost:3000/payment/callback

SMS_PROVIDER=disabled
ORDER_SMS_PROVIDER=disabled
OTP_EXPOSE_TEST_CODE=false
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=

WEB_PUSH_ENABLED=false
WEB_PUSH_VAPID_SUBJECT=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_TTL_SECONDS=21600
WEB_PUSH_URGENCY=normal

ENAMAD_ENABLED=false
ENAMAD_BADGE_CODE=

TELESCOPE_ENABLED=false
PULSE_ENABLED=false

BACKUP_DISK=local
BACKUP_RETENTION_DAYS=14
BACKUP_ENCRYPTION_PASSWORD=

LBB_BRAND_NAME="LBB"
LBB_BRAND_NAME_EN="LBB"
